# LLM: gemini | anthropic | openai | nvidia  (model names are pinned in lifeline/config.py)
LLM_PROVIDER=gemini
LLM_API_KEY=
# PayPal SANDBOX app credentials (US sandbox business account; Payouts is not available from some countries)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: your sandbox personal account email, so payouts land as SUCCESS instead of UNCLAIMED
PAYPAL_RECEIVER_EMAIL=
# Optional: token that lets a human reviewer release a YELLOW (unverifiable) appeal
LIFELINE_REVIEWER_TOKEN=
